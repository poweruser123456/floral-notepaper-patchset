@@ -0,0 +1,389 @@
+//! 剪贴板自动存档。
+//!
+//! 监听系统剪贴板变更，把新复制的文本按日期分片追加到「剪贴板归档」笔记里。
+//!
+//! ## 为什么监听放在 Rust 侧
+//!
+//! `tauri-plugin-clipboard-x` 的变更事件只携带空 payload，收到信号的一方需要
+//! 自己再去读剪贴板内容。而 Tauri 的事件是广播到所有窗口的——如果主窗口、小窗、
+//! 磁贴各自监听，就会产生三次读取和三次写库，把同一次复制写成三条笔记。
+//!
+//! 因此监听、读取、落库三件事全部收敛在 Rust 侧的单例里；前端只负责通过配置
+//! 开关告知启停。这样无论开多少窗口都只有一个监听器，也不依赖任何窗口存活。
+//!
+//! ## 数据流
+//!
+//! ```text
+//! clipboard-x 事件 → 读文本 → 去重/过滤 → NoteStore 写库 → emit("notes-changed")
+//! ```
+//!
+//! 落库复用 `NoteStore` 既有的读写路径，并广播花笺原有的 `notes-changed` 事件，
+//! 因此主窗口、小窗、磁贴会像其他任何笔记改动一样自动刷新。
+
+use crate::services::notes::{default_store, AppConfig, AppError, NoteMetadata, NoteStore, SaveNoteRequest};
+use chrono::Local;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Mutex,
+};
+use tauri::{AppHandle, Emitter, Listener, Manager};
+use tauri_plugin_clipboard_x as clipboard_x;
+
+/// clipboard-x 在剪贴板变更时广播的事件名。插件侧是字符串字面量，这里集中一处
+/// 便于升级时核对（见插件 `on_clipboard_change` 的 emit 调用）。
+const CLIPBOARD_CHANGED_EVENT: &str = "plugin:clipboard-x://clipboard_changed";
+
+/// 归档笔记标题前缀。按日期分片：`剪贴板归档-2026-09-14`。
+const ARCHIVE_TITLE_PREFIX: &str = "剪贴板归档";
+
+/// 表示「剪贴板里没有可归档的文本」的哨兵值，与真正的错误区分开。
+enum ReadOutcome {
+    /// 读到了非空文本。
+    Text(String),
+    /// 剪贴板为空，或内容是图片/文件等非文本类型——都不算错误。
+    Skipped,
+}
+
+/// 剪贴板监听的全局状态。
+#[derive(Default)]
+pub struct ClipboardWatchState {
+    /// 上一次已归档的内容，用于去重（值未变不重复写入）。
+    last_value: Mutex<Option<String>>,
+    /// 监听是否处于运行态。用于幂等保护：重复开启不会注册多个监听器。
+    running: AtomicBool,
+}
+
+impl ClipboardWatchState {
+    fn remember(&self, value: String) {
+        if let Ok(mut last) = self.last_value.lock() {
+            *last = Some(value);
+        }
+    }
+
+    fn is_duplicate(&self, value: &str) -> bool {
+        self.last_value
+            .lock()
+            .map(|last| last.as_deref() == Some(value))
+            .unwrap_or(false)
+    }
+
+    fn clear(&self) {
+        if let Ok(mut last) = self.last_value.lock() {
+            *last = None;
+        }
+    }
+
+    fn is_running(&self) -> bool {
+        self.running.load(Ordering::SeqCst)
+    }
+}
+
+/// 在应用启动时调用：注册事件处理，并按当前配置决定是否立即开启监听。
+///
+/// 即使当前配置是关闭的也要注册事件监听——用户在设置里开启后无需重启即可生效
+/// （事件回调自身会再校验一次开关状态）。
+pub fn setup_clipboard_watch(app: AppHandle) {
+    app.manage(ClipboardWatchState::default());
+
+    let listener_app = app.clone();
+    // 返回值只在需要主动注销时才有用，这里用 `let _` 显式丢弃，
+    // 既表明「不打算注销」的意图，也不会因 `#[must_use]` 触发告警。
+    let _ = app.listen(CLIPBOARD_CHANGED_EVENT, move |_event| {
+        // 事件回调是同步上下文，不能阻塞。读取与落库放到独立线程完成。
+        let app = listener_app.clone();
+        std::thread::spawn(move || {
+            if let Err(error) = archive_current_clipboard(&app) {
+                eprintln!("clipboard watch: failed to archive clipboard content: {error}");
+            }
+        });
+    });
+
+    if config_enabled() {
+        if let Err(error) = start(&app) {
+            eprintln!("clipboard watch: failed to start on startup: {error}");
+        }
+    }
+}
+
+/// 开始监听。幂等：重复调用不会注册第二个监听器。
+pub fn start(app: &AppHandle) -> Result<(), AppError> {
+    // 先把状态读出来，避免 State 借用与下面对 app 的使用交织。
+    let already_running = {
+        let state = app.state::<ClipboardWatchState>();
+        state.running.swap(true, Ordering::SeqCst)
+    };
+    if already_running {
+        return Ok(());
+    }
+
+    // clipboard-x 的 start_listening 自身也是幂等的，这里额外用 running 标志
+    // 做一层保护，避免启停快速切换时重复注册。
+    match run_async(clipboard_x::start_listening(app.clone())) {
+        Ok(()) => Ok(()),
+        Err(error) => {
+            app.state::<ClipboardWatchState>()
+                .running
+                .store(false, Ordering::SeqCst);
+            Err(clipboard_watch_error("clipboardWatchStart", error))
+        }
+    }
+}
+
+/// 停止监听。同时清空去重状态，下次开启时重新计算。
+pub fn stop(app: &AppHandle) -> Result<(), AppError> {
+    let already_stopped = {
+        let state = app.state::<ClipboardWatchState>();
+        !state.running.swap(false, Ordering::SeqCst)
+    };
+    if already_stopped {
+        return Ok(());
+    }
+
+    app.state::<ClipboardWatchState>().clear();
+
+    match run_async(clipboard_x::stop_listening()) {
+        Ok(()) => Ok(()),
+        Err(error) => Err(clipboard_watch_error("clipboardWatchStop", error)),
+    }
+}
+
+/// 把监听启停对齐到配置的当前值。供 `config_save` 的运行时变更流程调用，
+/// 这样用户在设置里勾选后无需重启即可生效。
+pub fn apply_config(app: &AppHandle, enabled: bool) -> Result<(), AppError> {
+    let currently_running = {
+        let state = app.state::<ClipboardWatchState>();
+        state.is_running()
+    };
+
+    match (enabled, currently_running) {
+        (true, false) => start(app),
+        (false, true) => stop(app),
+        _ => Ok(()),
+    }
+}
+
+fn config_enabled() -> bool {
+    default_store()
+        .and_then(|store| store.load_config())
+        .map(|config| config.clipboard_watch_enabled)
+        .unwrap_or(false)
+}
+
+/// 处理一次剪贴板变更：读取 → 过滤 → 归档。
+fn archive_current_clipboard(app: &AppHandle) -> Result<(), AppError> {
+    let state = app.state::<ClipboardWatchState>();
+    if !state.is_running() {
+        return Ok(());
+    }
+
+    let store = default_store()?;
+    let config = store.load_config()?;
+    if !config.clipboard_watch_enabled {
+        return Ok(());
+    }
+
+    // 剪贴板里可能是图片、文件等非文本内容，此时读取会失败或返回空串，
+    // 静默跳过即可——这不是错误情况。
+    let text = match read_current_text()? {
+        ReadOutcome::Text(text) => text,
+        ReadOutcome::Skipped => return Ok(()),
+    };
+
+    // 去重：同一次复制可能触发多次变更事件。
+    if state.is_duplicate(&text) {
+        return Ok(());
+    }
+
+    let truncated = truncate_chars(&text, config.clipboard_watch_max_chars);
+    append_entry(&store, &config, &truncated)?;
+
+    // 写库成功后再更新去重状态，保证失败时下次事件仍会重试。
+    state.remember(text);
+
+    // 复用花笺既有事件，主窗口 / 小窗 / 磁贴会像其他笔记改动一样自动刷新。
+    let _ = app.emit("notes-changed", ());
+
+    Ok(())
+}
+
+/// 读取当前剪贴板文本；非文本或空内容返回 `Skipped`。
+fn read_current_text() -> Result<ReadOutcome, AppError> {
+    match run_async(clipboard_x::read_text()) {
+        Ok(raw) => {
+            let trimmed = raw.trim();
+            if trimmed.is_empty() {
+                Ok(ReadOutcome::Skipped)
+            } else {
+                Ok(ReadOutcome::Text(trimmed.to_string()))
+            }
+        }
+        // 剪贴板内容不是文本（图片 / 文件）时读取会报错，属于正常情况。
+        Err(_) => Ok(ReadOutcome::Skipped),
+    }
+}
+
+/// 找到当天的归档笔记并追加一条记录。
+///
+/// 归档按日期分片（`剪贴板归档-2026-09-14`），避免单文件无限增长后每次写入都
+/// 全量重写——`NoteStore::update_note` 走的是「读全量 → 拼接 → 写全量」路径。
+fn append_entry(store: &NoteStore, config: &AppConfig, text: &str) -> Result<(), AppError> {
+    let title = archive_title();
+    let timestamp = Local::now().format("%H:%M:%S");
+    let entry = format!("## {timestamp}\n\n{text}\n");
+    let category = config.clipboard_watch_category.clone();
+
+    match find_archive_note(store, &title, &category)? {
+        Some(metadata) => {
+            let existing = store.read_note(&metadata.id)?;
+            let merged = if existing.content.trim().is_empty() {
+                format!("# {title}\n\n{entry}")
+            } else {
+                format!("{}\n{entry}", existing.content.trim_end())
+            };
+
+            // 先把要用的字段解构出来，避免在调用中同时借用 metadata.id
+            // 又移动 metadata.title / metadata.category。
+            let (id, note_title, note_category) =
+                (metadata.id, metadata.title, metadata.category);
+
+            store.update_note(
+                &id,
+                SaveNoteRequest {
+                    title: note_title,
+                    content: merged,
+                    category: note_category,
+                },
+            )?;
+        }
+        None => {
+            store.create_note(SaveNoteRequest {
+                title: title.clone(),
+                content: format!("# {title}\n\n{entry}"),
+                category,
+            })?;
+        }
+    }
+
+    Ok(())
+}
+
+/// 查找当天归档笔记。归档笔记可能已被用户删除，因此每次都回查列表，
+/// 找不到就重新创建（不缓存 id，避免删除后写入失败）。
+fn find_archive_note(
+    store: &NoteStore,
+    title: &str,
+    category: &str,
+) -> Result<Option<NoteMetadata>, AppError> {
+    Ok(store
+        .list_notes()?
+        .into_iter()
+        .find(|note| note.title == title && note.category == category))
+}
+
+fn archive_title() -> String {
+    format!("{ARCHIVE_TITLE_PREFIX}-{}", Local::now().format("%Y-%m-%d"))
+}
+
+/// 同步等待一个 clipboard-x 的 async 命令完成。
+///
+/// clipboard-x 的命令都是 `async fn`，而本模块的调用点（启动流程、配置热更新、
+/// 事件回调线程）都是同步上下文，需要拿到结果才能决定后续动作。
+///
+/// 这里刻意**不用** `tauri::async_runtime::block_on`：该方法在异步执行上下文内
+/// 调用会 panic，而调用链上游（`config_save` 同步命令）究竟运行在主线程还是
+/// 异步上下文，属于 Tauri 内部实现细节、不宜依赖。改为把 future 交给异步运行时
+/// 执行、再用 channel 同步取回结果——无论调用者身处哪种上下文都成立，
+/// 与项目在 updater 里使用 `async_runtime` 的既有风格也一致。
+fn run_async<F, T>(future: F) -> Result<T, String>
+where
+    F: std::future::Future<Output = Result<T, String>> + Send + 'static,
+    T: Send + 'static,
+{
+    let (sender, receiver) = std::sync::mpsc::channel();
+    tauri::async_runtime::spawn(async move {
+        let _ = sender.send(future.await);
+    });
+
+    receiver.recv().map_err(|error| error.to_string())?
+}
+
+fn clipboard_watch_error(code: &str, message: String) -> AppError {
+    AppError {
+        code: code.to_string(),
+        message,
+        details: Default::default(),
+    }
+}
+
+/// 按字符数截断（不是字节数），避免切断多字节字符。
+fn truncate_chars(value: &str, max_chars: usize) -> String {
+    if max_chars == 0 {
+        return String::new();
+    }
+
+    let mut chars = value.chars();
+    let truncated: String = chars.by_ref().take(max_chars).collect();
+
+    if chars.next().is_some() {
+        format!("{truncated}\n\n…（内容超长，已截断）")
+    } else {
+        truncated
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn truncate_keeps_short_text_intact() {
+        assert_eq!(truncate_chars("hello", 10), "hello");
+        assert_eq!(truncate_chars("hello", 5), "hello");
+    }
+
+    #[test]
+    fn truncate_marks_overlong_text() {
+        let result = truncate_chars("abcdef", 3);
+        assert!(result.starts_with("abc"));
+        assert!(result.contains("已截断"));
+    }
+
+    #[test]
+    fn truncate_handles_multibyte_without_panicking() {
+        let result = truncate_chars("中文内容测试", 2);
+        assert!(result.starts_with("中文"));
+        assert!(result.contains("已截断"));
+    }
+
+    #[test]
+    fn truncate_with_zero_limit_returns_empty() {
+        assert_eq!(truncate_chars("anything", 0), "");
+    }
+
+    #[test]
+    fn archive_title_includes_prefix_and_date() {
+        let title = archive_title();
+        assert!(title.starts_with(ARCHIVE_TITLE_PREFIX));
+        // 形如 剪贴板归档-2026-09-14，共三个连字符
+        assert_eq!(title.matches('-').count(), 3);
+    }
+
+    #[test]
+    fn duplicate_detection_tracks_last_value() {
+        let state = ClipboardWatchState::default();
+        assert!(!state.is_duplicate("a"));
+
+        state.remember("a".to_string());
+        assert!(state.is_duplicate("a"));
+        assert!(!state.is_duplicate("b"));
+
+        state.clear();
+        assert!(!state.is_duplicate("a"));
+    }
+
+    #[test]
+    fn running_flag_starts_stopped() {
+        let state = ClipboardWatchState::default();
+        assert!(!state.is_running());
+    }
+}
